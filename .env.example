# ============================================================
# Middleware 统一环境配置
# ============================================================
# 使用方法:
#   cp .env.example .env
#   然后编辑 .env 修改密码等敏感信息
#
# 注意: .env 已被 .gitignore 忽略，不会提交到 Git
# ============================================================

# -------------------- 通用 --------------------
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=middleware

# -------------------- 网络 --------------------
# 自定义网段，避免与宿主机网络冲突
NETWORK_SUBNET=172.28.0.0/16

# -------------------- PostgreSQL --------------------
POSTGRES_VERSION=18
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_you_password
# POSTGRES_DB=middleware
POSTGRES_DATA_DIR=./postgres/data
POSTGRES_CONF_DIR=./postgres/conf
# PostgreSQL 容器内共享内存大小256mb
POSTGRES_SHM_SIZE=256mb

# -------------------- Redis --------------------
REDIS_VERSION=7
REDIS_PORT=6379
REDIS_PASSWORD=change_you_password
REDIS_DATA_DIR=./redis/data
# Redis 最大内存限制
REDIS_MAXMEMORY=512mb
# Redis 内存淘汰策略: allkeys-lru | volatile-lru | noeviction
REDIS_MAXMEMORY_POLICY=allkeys-lru

# -------------------- Nacos --------------------
NACOS_VERSION=v3.2.2
NACOS_HTTP_PORT=8080
NACOS_GRPC_CLIENT_PORT=9080
NACOS_GRPC_SERVER_PORT=9081
NACOS_DB_NAME=nacos
# JWT 签名密钥，生产环境务必更换（至少 32 位）
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# -------------------- Sentinel Dashboard --------------------
SENTINEL_VERSION=latest
SENTINEL_PORT=8858
SENTINEL_USERNAME=sentinel
SENTINEL_PASSWORD=sentinel
SENTINEL_CONF_DIR=./sentinel/conf

# -------------------- DokuWiki --------------------
DOKUWIKI_VERSION=latest
DOKUWIKI_PORT=8088

# -------------------- SkyWalking --------------------
SKYWALKING_VERSION=11.0.0
# SkyWalking 11 起 UI 独立发版（Horizon），Docker Hub tag 形如 horizon-<version>
SKYWALKING_UI_VERSION=horizon-1.0.1
BANYANDB_VERSION=0.11.1
SKYWALKING_UI_PORT=8801
SKYWALKING_OAP_GRPC_PORT=11800
SKYWALKING_OAP_HTTP_PORT=12800
SKYWALKING_OAP_ADMIN_PORT=17128
# Horizon UI 本地登录用户（JSON 数组，passwordHash 为 Argon2id）
# 默认账号 admin / admin，请务必修改密码！
# 生成新哈希：
# docker run --rm --entrypoint node apache/skywalking-ui:horizon-1.0.1 \
#   -e "require('argon2').hash('新密码').then(console.log)"
HORIZON_AUTH_LOCAL_USERS='[{"username":"admin","passwordHash":"$argon2id$v=19$m=65536,t=3,p=4$jPQgpw8hXApbjBhjk2lx3w$wXiFdPezduDOeZsjlJb+nMmOusfQQGJz+IOOUPfs1zQ","roles":["admin"]}]'

# -------------------- 备份 --------------------
BACKUP_DIR=./backups
# 备份保留天数
BACKUP_RETENTION_DAYS=30

# -------------------- 日志 --------------------
LOG_DIR=./logs
# 日志保留天数
LOG_RETENTION_DAYS=14
